# Rendered at container start by the nginx image's envsubst entrypoint, which
# writes this out as /etc/nginx/conf.d/default.conf. Only ${APP_DOMAIN} is
# substituted - NGINX_ENVSUBST_FILTER in the compose file keeps envsubst away
# from nginx's own $variables.

server {
    listen       80;
    server_name  ${APP_DOMAIN};
    server_tokens off;

    # The http-01 challenge has to be answered over plain HTTP, so this sits
    # ahead of the redirect. certbot writes the token here, nginx serves it.
    location /.well-known/acme-challenge/ {
        root /var/www/certbot;
    }

    # Exempt from the redirect so the container healthcheck does not have to
    # chase a 301 into TLS and DNS from inside the container.
    location = /healthz {
        access_log off;
        return 200 "ok\n";
    }

    # Everything else is redirected to the canonical https origin. Redirecting
    # to ${APP_DOMAIN} rather than $host means a request that arrived at the
    # bare IP does not land on a certificate that cannot match it.
    location / {
        return 301 https://${APP_DOMAIN}$request_uri;
    }
}

server {
    listen       443 ssl;
    http2        on;
    server_name  ${APP_DOMAIN};
    server_tokens off;

    ssl_certificate     /etc/letsencrypt/live/${APP_DOMAIN}/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/${APP_DOMAIN}/privkey.pem;

    # Roughly Mozilla's "intermediate" profile. No OCSP stapling: Let's Encrypt
    # has wound its OCSP responders down, so there is nothing to staple.
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_prefer_server_ciphers off;
    ssl_ciphers ECDHE-ECDSA-AES128-GCM-SHA256:ECDHE-RSA-AES128-GCM-SHA256:ECDHE-ECDSA-AES256-GCM-SHA384:ECDHE-RSA-AES256-GCM-SHA384:ECDHE-ECDSA-CHACHA20-POLY1305:ECDHE-RSA-CHACHA20-POLY1305;
    ssl_session_cache shared:SSL:10m;
    ssl_session_timeout 1d;
    ssl_session_tickets off;

    gzip on;
    gzip_types text/css application/javascript application/json image/svg+xml;
    gzip_min_length 1024;

    # Security headers. No CSP is set here because it needs to match however
    # the app is deployed; add one once the tile/API origins are settled.
    # No HSTS either, deliberately - see TODO.txt. The redirect above still
    # sends everyone to https; HSTS is what stops a downgrade, and it is not
    # worth committing every visitor's browser to for a year until this has
    # been running cleanly for a while.
    add_header X-Content-Type-Options "nosniff" always;
    add_header X-Frame-Options "SAMEORIGIN" always;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;

    # Static content
    location / {
        root /usr/share/nginx/html;
        try_files $uri /index.html;
    }

    # Hashed build assets are immutable. add_header is not inherited into a
    # location that sets its own, so nosniff has to be repeated here to apply
    # to the scripts and stylesheets it matters most for.
    location /assets/ {
        root /usr/share/nginx/html;
        expires 1y;
        add_header Cache-Control "public, immutable";
        add_header X-Content-Type-Options "nosniff" always;
    }

    # Proxy the api
    location /api/ {
        proxy_pass         http://backend-prod:6200/api/;
        proxy_set_header   Host $host;
        proxy_set_header   X-Real-IP $remote_addr;
        proxy_set_header   X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header   X-Forwarded-Proto $scheme;
    }
}
