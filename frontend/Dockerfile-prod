# Build
FROM node:24-alpine AS build

WORKDIR /app

COPY package.json package-lock.json ./
RUN npm ci

COPY . .
RUN npm run build


# Production
FROM nginx:1.29-alpine

COPY --from=build /app/build /usr/share/nginx/html

# Dropped in as a template rather than straight into conf.d: the image's
# entrypoint runs it through envsubst to fill in ${APP_DOMAIN}.
COPY nginx.conf.template /etc/nginx/templates/default.conf.template

# Run before nginx starts: 15- refuses to start without a certificate, 99-
# backgrounds the reload loop that picks renewed ones up.
COPY docker-entrypoint.d/ /docker-entrypoint.d/
RUN chmod +x /docker-entrypoint.d/*.sh

EXPOSE 80 443

CMD ["nginx", "-g", "daemon off;"]
