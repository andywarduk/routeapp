# Strava application credentials
STRAVA_CLIENT_ID=[Strava app client ID]
STRAVA_CLIENT_SECRET=[Strava app secret]

# Signing key for the app's own session tokens. Required - startup fails
# without it. Use a long random string.
JWT_SECRET=[jwt secret]

# Athlete ID granted admin on first login (optional)
SUPER_ATHLETE=[athlete ID for admin]

# Mongo root credentials, consumed by both the mongo image and the backend
MONGO_INITDB_ROOT_USERNAME=[mongo root user ID]
MONGO_INITDB_ROOT_PASSWORD=[mongo root user password]

# Optional overrides
# PORT=6200
# JWT_ISSUER=corsham.cc
# How long issued tokens stay valid. Any jsonwebtoken duration ('7d', '12h').
# JWT_EXPIRES_IN=7d
# Comma-separated origins allowed to call the API cross-origin. Leave unset
# unless the frontend is served from a different origin than the API - both
# compose stacks proxy /api, so it is same-origin and CORS stays off.
# CORS_ORIGIN=
# MONGO_HOST=mongodb-dev
# MONGO_DB=routes
