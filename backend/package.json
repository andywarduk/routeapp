{
  "name": "backend",
  "version": "1.0.0",
  "description": "Route app backend",
  "scripts": {
    "build": "tsc",
    "watch": "concurrently -k -p \"[{name}]\" -n \"tsc,nodemon\" -c \"cyan.bold,green.bold\" \"tsc --watch\" \"nodemon --watch build build/app.js\"",
    "start": "node build/app.js",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "echo \"Error: no test specified\" && exit 1"
  },
  "author": "",
  "license": "ISC",
  "dependencies": {
    "axios": "^1.19.0",
    "cors": "^2.8.5",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "jsonwebtoken": "^9.0.3",
    "mongoose": "^9.9.3",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^22.18.9",
    "@types/passport": "^1.0.17",
    "@types/passport-jwt": "^4.0.1",
    "concurrently": "^10.0.5",
    "eslint": "^10.9.1",
    "globals": "^17.11.0",
    "nodemon": "^3.1.14",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.68.0"
  },
  "engines": {
    "node": ">=22"
  }
}
