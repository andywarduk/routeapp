# Deployment settings for docker-compose-prod.yml. Copy to .env and fill in.
# Only the production stack reads these; the dev stack is plain HTTP.

# The public hostname the app is served on. Needs a DNS A/AAAA record pointing
# at this host before a certificate can be issued, and it is what goes in the
# nginx server_name and the certificate.
APP_DOMAIN=[public hostname, e.g. routes.example.com]

# Contact address Let's Encrypt uses for expiry warnings.
CERTBOT_EMAIL=[email address]
